# ==============================================================================
# Haron Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# API Server Host and Port (external port 8001 to avoid conflicts)
API_HOST=0.0.0.0
API_PORT=8001

# PostgreSQL Database Configuration
# Local host port 5436 maps to internal postgres container port 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5436
POSTGRES_DB=haron
POSTGRES_USER=haron
POSTGRES_PASSWORD=haron_secret
DATABASE_URL=postgresql+asyncpg://haron:haron_secret@localhost:5436/haron

# Redis Configuration (arq job broker, token bucket rate limiter)
# Local host port 6382 maps to internal redis container port 6379
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_URL=redis://localhost:6382/0

# JWT Authentication Secrets (Argon2 password hashing + rotating refresh tokens)
# Minimum 32 characters for security
JWT_SECRET_KEY=development_jwt_secret_key_change_in_production_32chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage / S3 Configuration (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=haron-assets
S3_REGION=us-east-1

# LLM Provider Configuration (Phase 4 & 5)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# Image Provider Configuration (Phase 6)
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_WEBHOOK_SECRET=development_webhook_secret_for_image_provider

# Observability
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true
